Module
  name: game_proficiency
  description: Weapon Proficiency System
  sandboxed: true
  scripts: [ const, proficiency_data, proficiency ]
  # desativado: Shinobi Legends (ADR-005) -- era autoload: true
  autoload: false
  autoload-priority: 1200
  minClientVersion: 1511
  dependencies:
    - game_interface
  @onLoad: init()
  @onUnload: terminate()

