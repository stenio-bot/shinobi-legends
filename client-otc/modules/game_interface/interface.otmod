Module
  name: game_interface
  description: Create the game interface, where the ingame stuff starts
  author: OTClient team
  website: https://github.com/edubart/otclient
  sandboxed: true
  scripts: [ widgets/uigamemap, widgets/uiitem, widgets/statsbar, gameinterface ]
  load-later:
    - game_walk
    - game_joystick
    - game_shortcuts
    - game_minimap
    - game_healthinfo
    - game_inventory
    - game_mainpanel
    #- game_prey   # desativado: Shinobi Legends (ADR-005)
    #- game_imbuing   # desativado: Shinobi Legends (ADR-005)
    #- game_imbuementtracker   # desativado: Shinobi Legends (ADR-005)
    - game_hotkeys
    - game_questlog
    - game_textmessage
    - game_console
    - game_actionbar
    - game_outfit
    - game_skills
    - game_containers
    - game_viplist
    - game_battle
    - game_npctrade
    - game_textwindow
    - game_playertrade
    - game_bugreport
    - game_playerdeath
    #- game_playermount   # desativado: Shinobi Legends (ADR-005)
    #- game_ruleviolation   # desativado: Shinobi Legends (ADR-005)
    #- game_market   # desativado: Shinobi Legends (ADR-005)
    - game_spelllist
    - game_cooldown
    - game_modaldialog
    #- game_unjustifiedpoints   # desativado: Shinobi Legends (ADR-005)
    - game_shaders
    - game_attachedeffects
    #- game_paperdolls   # desativado: Shinobi Legends (ADR-005)
    #- game_stash   # desativado: Shinobi Legends (ADR-005)
    - game_healthcircle
    #- game_shop   # desativado: Shinobi Legends (ADR-005)
    - game_notifications
    #- game_highscore   # desativado: Shinobi Legends (ADR-005)
    #- game_blessing   # desativado: Shinobi Legends (ADR-005)
    #- game_store   # desativado: Shinobi Legends (ADR-005)
    - game_quickloot
    #- game_cyclopedia   # desativado: Shinobi Legends (ADR-005)
    - game_creatureinformation
    #- game_rewardwall   # desativado: Shinobi Legends (ADR-005)
    #- game_forge   # desativado: Shinobi Legends (ADR-005)
    #- game_tutorial   # desativado: Shinobi Legends (ADR-005)
    - game_inspect
    #- game_taskboard   # desativado: Shinobi Legends (ADR-005)
    #- game_wheel   # desativado: Shinobi Legends (ADR-005)
    #- game_proficiency   # desativado: Shinobi Legends (ADR-005)

  @onLoad: init()
  @onUnload: terminate()
