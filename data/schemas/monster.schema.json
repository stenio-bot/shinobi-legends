{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monster",
  "type": "object",
  "required": ["id","name","level","hp","attack","defense","speed","element","xp","behavior","aggro_range","attack_range","attacks","loot","ryo_min","ryo_max","respawn_s"],
  "additionalProperties": false,
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9_]+$"},
    "name": {"type":"string"},
    "description": {"type":"string"},
    "article": {"type":"string","description":"um/uma/o/a, usado no nameDescription do TFS"},
    "level": {"type":"integer","minimum":1},
    "hp": {"type":"integer","minimum":1},
    "attack": {"type":"integer","minimum":0},
    "defense": {"type":"integer","minimum":0},
    "speed": {"type":"number","minimum":0,"description":"tiles por segundo"},
    "element": {"enum":["katon","suiton","doton","fuuton","raiton","none"]},
    "xp": {"type":"integer","minimum":0},
    "behavior": {"enum":["passive","aggressive","cowardly","ranged"]},
    "aggro_range": {"type":"integer","minimum":0},
    "attack_range": {"type":"integer","minimum":1},
    "attacks": {"type":"array","minItems":1,"items":{
      "type":"object","required":["name","damage_min","damage_max","cooldown_s","type"],
      "properties":{
        "name":{"type":"string"},
        "damage_min":{"type":"integer"},
        "damage_max":{"type":"integer"},
        "cooldown_s":{"type":"number"},
        "type":{"enum":["melee","projectile","area"]},
        "shape":{"type":"string"},
        "effects":{"type":"array"}
      }}},
    "loot": {"type":"array","items":{
      "type":"object","required":["item_id","chance"],
      "properties":{
        "item_id":{"type":"string"},
        "chance":{"type":"number","minimum":0,"maximum":1},
        "min":{"type":"integer","minimum":1},
        "max":{"type":"integer","minimum":1}
      }}},
    "ryo_min": {"type":"integer","minimum":0},
    "ryo_max": {"type":"integer","minimum":0},
    "respawn_s": {"type":"integer","minimum":1},
    "boss": {"type":"boolean","default":false},
    "phases": {"type":"array","items":{"type":"object"}},
    "sprite": {"type":"string"}
  }
}
